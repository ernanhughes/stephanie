# Stephanie Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# Database Configuration (PostgreSQL + pgvector)
# =============================================================================
STEPHANIE_DB_HOST=localhost
STEPHANIE_DB_PORT=5432
STEPHANIE_DB_NAME=stephanie
STEPHANIE_DB_USER=stephanie
STEPHANIE_DB_PASSWORD=your_secure_password_here

# SIS (Stephanie Insight System) Database - separate from main Stephanie DB
SIS_DB_HOST=localhost
SIS_DB_PORT=5432
SIS_DB_NAME=stephanie
SIS_DB_USER=stephanie
SIS_DB_PASSWORD=your_secure_password_here

# =============================================================================
# SIS Authentication
# =============================================================================
SIS_AUTH_USERNAME=stephanie
SIS_AUTH_DISABLED=false
SIS_ALLOW_INSECURE_AUTH=false
SIS_COOKIE_SECURE=false
SIS_SESSION_SECRET=your_32_byte_session_secret_here

# =============================================================================
# Model Inference (Ollama)
# =============================================================================
STEPHANIE_OLLAMA_URL=http://localhost:11434

# =============================================================================
# Web Search (SearXNG)
# =============================================================================
STEPHANIE_SEARXNG_URL=http://localhost:8080
STEPHANIE_SEARXNG_SECRET=change-me-stephanie

# =============================================================================
# Chat Model API Key (for non-Ollama models)
# =============================================================================
STEPHANIE_CHAT_API_KEY=

# =============================================================================
# Worker / OpenCode Integration (STN03+)
# =============================================================================
STEPHANIE_WORKER_BASE_URL=http://127.0.0.1:7317

# =============================================================================
# Writer Integration (Optional)
# =============================================================================
STEPHANIE_WRITER_PROJECT_ROOT=C:/Projects/Writer

# =============================================================================
# Workspace Paths (STN03/STN04)
# =============================================================================
STEPHANIE_WORKSPACE_STN03=C:/Users/yourusername/AppData/Local/Temp/opencode/stn03-dry-run
STEPHANIE_WORKSPACE_STN04=C:/Projects/stephanie-test-workspace

# =============================================================================
# Network Bindings (for Docker Compose)
# =============================================================================
STEPHANIE_DB_BIND=127.0.0.1
STEPHANIE_DB_FORWARD_PORT=5432
STEPHANIE_NATS_BIND=127.0.0.1
STEPHANIE_NATS_PORT=4222
STEPHANIE_NATS_MONITOR_BIND=127.0.0.1
STEPHANIE_NATS_MONITOR_PORT=8222
STEPHANIE_SEARXNG_BIND=127.0.0.1
STEPHANIE_SEARXNG_PORT=8080
STEPHANIE_OLLAMA_BIND=127.0.0.1
STEPHANIE_OLLAMA_PORT=11434
SIS_BIND=127.0.0.1
SIS_PORT=8000