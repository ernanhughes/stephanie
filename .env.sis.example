# SIS authentication secrets for Docker Compose.
#
# Copy to `.env.sis` (git-ignored) and fill in before `docker compose up`:
#   Copy-Item .env.sis.example .env.sis      # PowerShell
#   cp .env.sis.example .env.sis             # bash
#
# This file is delivered to the app container via `env_file:` in
# docker-compose.yml. It is kept separate from `.env` because Docker Compose
# interpolates "$" in these values, and a PBKDF2 password hash is full of them.
#
# IMPORTANT: double every "$" as "$$". A raw hash is silently truncated.
#
#   SIS_AUTH_PASSWORD_HASH
#     Generate the escaped value directly (recommended):
#       python -c "from sis.security import hash_password; print(hash_password('YOUR-PASSWORD').replace('$','$$'))"
#     Or run `python -m sis.security --hash-password` and hand-edit every "$" to "$$".
#
#   SIS_SESSION_SECRET
#     urlsafe base64 — never contains "$", so write it as-is:
#       python -c "import secrets; print(secrets.token_urlsafe(48))"

SIS_AUTH_PASSWORD_HASH=
SIS_SESSION_SECRET=
