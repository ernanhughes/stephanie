# Stephanie Docker Compose environment.
#
# Copy to `.env.docker` (git-ignored) and edit before `docker compose up`:
#   Copy-Item .env.docker.example .env.docker      # PowerShell
#   cp .env.docker.example .env.docker             # bash
#
# Pass it explicitly on every Compose command:
#   docker compose --env-file .env.docker up -d --build
#
# NOTE: the file is deliberately NOT named `.env`. `litellm` (a Stephanie
# dependency) calls `load_dotenv()`, which reads a repo-root `.env` into the
# process environment, so a `.env` holding these values would silently repoint
# local runs and tests at the container database. See docs/docker.md.
#
# Docker Compose reads this file for ${VAR} substitution in docker-compose.yml.

# --- Database ---------------------------------------------------------------
STEPHANIE_DB_NAME=stephanie
STEPHANIE_DB_USER=stephanie
# Change this before first start; it seeds the Postgres role and is reused by
# the app, db-init and (via .env) every service.
STEPHANIE_DB_PASSWORD=change-me
# Host port the database is published on (bound to STEPHANIE_DB_BIND).
STEPHANIE_DB_FORWARD_PORT=5432
STEPHANIE_DB_BIND=127.0.0.1

# --- SIS web application ----------------------------------------------------
SIS_AUTH_USERNAME=stephanie
SIS_PORT=8000
SIS_BIND=127.0.0.1
SIS_COOKIE_SECURE=false
# Password-free local mode. Set SIS_AUTH_DISABLED=true to skip the SIS login
# entirely. Because the app binds 0.0.0.0 inside the container you must also set
# SIS_ALLOW_INSECURE_AUTH=true to acknowledge it; keep SIS_BIND=127.0.0.1 so the
# port is only published on loopback.
SIS_AUTH_DISABLED=false
SIS_ALLOW_INSECURE_AUTH=false
# NOTE: SIS_AUTH_PASSWORD_HASH and SIS_SESSION_SECRET live in .env.sis, not here.
# A PBKDF2 hash contains "$", which Docker Compose interpolates inside .env.
# .env.sis is loaded verbatim via `env_file`. See .env.sis.example and docs/docker.md.
# They are ignored entirely when SIS_AUTH_DISABLED=true.

# --- Search -----------------------------------------------------------------
# Change before exposing the instance.
STEPHANIE_SEARXNG_SECRET=change-me-stephanie
STEPHANIE_SEARXNG_PORT=8080
STEPHANIE_SEARXNG_BIND=127.0.0.1

# --- Message bus (NATS) -----------------------------------------------------
STEPHANIE_NATS_PORT=4222
STEPHANIE_NATS_BIND=127.0.0.1
STEPHANIE_NATS_MONITOR_PORT=8222
STEPHANIE_NATS_MONITOR_BIND=127.0.0.1

# --- Model runtime (Ollama) -------------------------------------------------
STEPHANIE_OLLAMA_PORT=11434
STEPHANIE_OLLAMA_BIND=127.0.0.1
