# Stephanie Docker Compose environment.
#
# Copy to `.env` (git-ignored) and edit before `docker compose up`:
#   Copy-Item .env.docker.example .env      # PowerShell
#   cp .env.docker.example .env             # bash
#
# Docker Compose reads `.env` automatically for ${VAR} substitution in
# docker-compose.yml. See docs/docker.md.

# --- Database ---------------------------------------------------------------
STEPHANIE_DB_NAME=stephanie
STEPHANIE_DB_USER=stephanie
# Change this before first start; it seeds the Postgres role and is reused by
# the app, db-init and (via .env) every service.
STEPHANIE_DB_PASSWORD=change-me
# Host port the database is published on (bound to STEPHANIE_DB_BIND).
STEPHANIE_DB_FORWARD_PORT=5432
STEPHANIE_DB_BIND=127.0.0.1

# --- SIS web application ----------------------------------------------------
# Generate a password hash without echoing the password:
#   python -m sis.security --hash-password
SIS_AUTH_USERNAME=stephanie
SIS_AUTH_PASSWORD_HASH=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SIS_SESSION_SECRET=
SIS_PORT=8000
SIS_BIND=127.0.0.1
SIS_COOKIE_SECURE=false

# --- Search -----------------------------------------------------------------
# Change before exposing the instance.
STEPHANIE_SEARXNG_SECRET=change-me-stephanie
STEPHANIE_SEARXNG_PORT=8080
STEPHANIE_SEARXNG_BIND=127.0.0.1

# --- Message bus (NATS) -----------------------------------------------------
STEPHANIE_NATS_PORT=4222
STEPHANIE_NATS_BIND=127.0.0.1
STEPHANIE_NATS_MONITOR_PORT=8222
STEPHANIE_NATS_MONITOR_BIND=127.0.0.1

# --- Model runtime (Ollama) -------------------------------------------------
STEPHANIE_OLLAMA_PORT=11434
STEPHANIE_OLLAMA_BIND=127.0.0.1
